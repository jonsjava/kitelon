# Copy to .env in the repository root for docker compose:
#   cp docker/env.example .env
#
# POSTGRES_PASSWORD is required for first boot.

POSTGRES_PASSWORD=change_me
POSTGRES_USER=kitelon
POSTGRES_DB=kitelon

# Web UI API key (X-API-Key header). Required.
# Leave empty to generate one at container start (printed in kitelon-web logs
# and stored in /root/.kitelon_api_keys.conf).
WEB_API_KEY=

# Scan workloads: skip interactive legal prompt in containers (set only when
# your environment already enforces authorized testing policy).
# KITELON_I_ACCEPT_AUTHORIZED_USE=1

# Published Web UI port on the host
KITELON_WEB_PORT=8080
