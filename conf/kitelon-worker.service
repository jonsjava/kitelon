[Unit]
Description=Kitelon job worker (PostgreSQL queue)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/kitelon/bin/kitelon_worker.py run
Restart=always
RestartSec=5
# The worker requeues running jobs on SIGTERM (WORKER_SHUTDOWN_GRACE_SEC=60).
TimeoutStopSec=90
Environment=KITELON_INSTALL_DIR=/usr/share/kitelon
Environment=KITELON_BIN=/usr/share/kitelon/kitelon
Environment=WORKER_POST_CONCURRENCY=2
Environment=WORKER_ROLE=both

[Install]
WantedBy=multi-user.target
