    dos2unix /root/.kitelon.conf 2> /dev/null > /dev/null
    source /root/.kitelon.conf
    sleep 1
    shift
    shift
    ;;
    -t)
    TARGET="$2"
    shift
    shift
    ;;
    -b)
    AUTO_BRUTE="1"
    shift
    ;;
    -fp|--fullportscan)
    FULLNMAPSCAN="1"
    shift
    ;;
    -o|--osint)
    OSINT="1"
    shift
    ;;
    -re|--recon)
    RECON="1"
    shift
    ;;
    --preset)
    PRESET="$2"
    shift
    shift
    ;;
    --testssl)
    TESTSSL="1"
    shift
    ;;
    --testssl-only)
    TESTSSL_ONLY="1"
    shift
    ;;
    --force)
    TESTSSL_FORCE="1"
    shift
    ;;
    --reports)
    TESTSSL_REPORTS="1"
    shift
    ;;
    -m)
    MODE="$2"
    shift
    shift
    ;;
    -p)
    PORT="$2"
    shift
    shift
    ;;
    -f|--file)
    FILE="$(realpath $2)"
    shift
    shift
    ;;
    -ri|--reimport)
    REIMPORT="1"
    shift
    ;;
    -rl|--reload)
    RELOAD="1"
    shift
    ;;
    -n|--noreport)
    REPORT="0"
    shift
    ;;
    -nl|--noloot)
    LOOT="0"
    NOLOOT="1"
    shift
    ;;
    -w)
    WORKSPACE="$2"
    kitelon_apply_workspace
    shift
    shift
    ;;
    -s|--schedule)
    if [[ -z "$WORKSPACE" ]]; then
      echo "You need to set a workspace via the -w switch to schedule a scan task."
      exit
    fi
    if [[ -z "$TARGET" ]]; then
      echo "You need to set a target via -t to schedule a scan."
      exit
    fi
    SCHEDULE_ARG="$2"
    if [[ "${DB_ENABLED:-1}" == "1" ]]; then
      MODE="${MODE:-normal}"
      export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
      python3 "$INSTALL_DIR/bin/kitelon_db.py" schedule \
        --workspace "$WORKSPACE" \
        --cron "$SCHEDULE_ARG" \
        --target "$TARGET" \
        --mode "$MODE" \
        --loot-root "$INSTALL_DIR/loot" || exit 1
      echo -e "$KL_C_OK[✓]$KL_RESET Scheduled cron scan ($SCHEDULE_ARG): $TARGET ($MODE) in workspace $WORKSPACE"
      exit 0
    fi
    echo "Scheduling requires DB_ENABLED=1 and PostgreSQL."
    exit 1
    ;;
    db)
    DB_SUBCMD="$2"
    shift 2
    if [[ "$DB_SUBCMD" == "import" && $# -gt 0 && "$1" != -* ]]; then
      WORKSPACE="$1"
      kitelon_apply_workspace
      shift
    fi
    ;;
    jobs)
    JOBS_SUBCMD="$2"
    shift
    shift
    ;;
    workspaces)
    WORKSPACES_SUBCMD="$2"
    shift
    shift
    ;;
    --web)
    WEB_MODE="1"
    shift
    ;;
    -d|--delete)
    kl_print_header
    if [[ -z "$WORKSPACE" ]]; then
      echo "You need to specify a workspace via -w to delete."
      exit 1
    fi
    echo "Remove workspace $WORKSPACE? Loot on disk will be deleted. (Ctrl+C to abort)"
    read -r ANS
    export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
    kitelon_export_db_env
    if [[ "${DB_ENABLED:-1}" == "1" ]]; then
      python3 "$INSTALL_DIR/bin/kitelon_crud.py" workspaces delete "$WORKSPACE" --delete-loot || exit 1
      echo -e "$KL_C_OK[✓]$KL_RESET Workspace $WORKSPACE removed (database + loot)"
    else
      rm -Rf "$INSTALL_DIR/loot/workspace/$WORKSPACE/"
      echo "Workspace $INSTALL_DIR/loot/workspace/$WORKSPACE/ was removed."
    fi
    if [[ "$WORKSPACE" != "default" ]]; then
      mkdir -p "$INSTALL_DIR/loot/workspace/default"
    fi
    exit
    shift
    ;;
    -dh|--delete-host)
    echo "Removing $TARGET from $WORKSPACE"
    sed -i "/$TARGET/d" "$WORKSPACE_DIR"/domains/* "$WORKSPACE_DIR"/reports/host-table-report.csv
    egrep -R "$TARGET" "$WORKSPACE_DIR"/domains/* "$WORKSPACE_DIR"/reports/host-table-report.csv
    rm -f "$WORKSPACE_DIR"/screenshots/"$TARGET"*.jpg 2> /dev/null
    rm -f "$WORKSPACE_DIR"/nmap/dns-"$TARGET".txt 2> /dev/null
    rm -f "$WORKSPACE_DIR"/nmap/ports-"$TARGET".txt 2> /dev/null
    rm -f "$WORKSPACE_DIR"/artifacts/nmap/"$TARGET".xml 2> /dev/null
    rm -f "$WORKSPACE_DIR"/artifacts/web/"$TARGET"/* 2> /dev/null
    rm -f "$WORKSPACE_DIR"/findings.jsonl 2> /dev/null
    exit
    shift
    ;;
    -dt|--delete-task)
    echo "Removing all running $TARGET tasks from $WORKSPACE"
    rm -vf $WORKSPACE_DIR/scans/running_$TARGET_*.txt
    ls -lh $LOOT_DIR/scans/running_*.txt 2> /dev/null | wc -l 2> /dev/null > $WORKSPACE_DIR/scans/tasks-running.txt 2> /dev/null
    ps -ef | egrep "$TARGET|kitelon"
    ps -ef | egrep "kitelon" | awk '{print $2}' | xargs -r sudo kill -9 {}
    exit
    shift
    ;;
    --list)
    kl_print_header
    ls -l $INSTALL_DIR/loot/workspace/
    echo ""
    echo "cd /usr/share/kitelon/loot/workspace/"
    WEB_URL="http://${WEB_BIND:-127.0.0.1}:${WEB_PORT:-8080}"
    if [[ -n "$WORKSPACE" ]]; then
      kl_section "Opening workspace in Web UI..."
      $BROWSER "${WEB_URL}/workspace.html?alias=${WORKSPACE}" 2> /dev/null > /dev/null &
    else
      kl_section "Opening Kitelon Web UI..."
      $BROWSER "${WEB_URL}/" 2> /dev/null > /dev/null &
    fi
    exit
    shift
    ;;
    --export)
    if [[ -z "$WORKSPACE" ]]; then
      echo "You need to set a workspace via the -w switch to export a workspace."
      exit
    fi
    export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
    kitelon_export_db_env
    OUT="${EXPORT_OUTPUT:-$INSTALL_DIR/loot/kitelon-${WORKSPACE}.zip}"
    python3 "$INSTALL_DIR/bin/kitelon_workspace_pack.py" export "$WORKSPACE" --output "$OUT" --loot-root "$INSTALL_DIR/loot" || exit 1
    echo "Exported $WORKSPACE to $OUT"
    exit
    shift
    ;;
    --import-zip)
    IMPORT_ZIP="$2"
    shift
    shift
    ;;
    --replace)
    IMPORT_REPLACE="1"
    shift
    ;;
    -s|--status)
    kitelon_status
    exit
    shift
    ;;
    --is-running)
    kitelon_is_running_cmd
    exit $?
    shift
    ;;
    --stop)
    kitelon_stop_cmd
    exit $?
    shift
    ;;
    -u|--update)
    UPDATE="1"
    update
    exit
    shift
    ;;
    -rr|--resume)
    RESUME="1"
    shift
    ;;
    *)
    # jobs/workspaces/db forward remaining tokens (aliases, --limit, --json, …)
    if [[ -n "$JOBS_SUBCMD" || -n "$WORKSPACES_SUBCMD" || -n "$DB_SUBCMD" ]]; then
      POSITIONAL+=("$1")
      shift
      continue
    fi
    echo "Unknown scan option $1...refer to the kl_help menu for usage details."
    exit 1
    ;;
esac
done
set -- "${POSITIONAL[@]}"

kitelon_export_db_env() {
  export DB_ENABLED="${DB_ENABLED:-1}"
  export DB_HOST="${DB_HOST:-127.0.0.1}"
  export DB_PORT="${DB_PORT:-5432}"
  export DB_NAME="${DB_NAME:-kitelon}"
  export DB_USER="${DB_USER:-postgres}"
}

if [[ -n "$DB_SUBCMD" ]]; then
  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  kitelon_export_db_env
  case "$DB_SUBCMD" in
    migrate)
      python3 "$INSTALL_DIR/bin/kitelon_db.py" migrate || exit 1
      echo -e "$KL_C_OK[✓]$KL_RESET PostgreSQL schema migrated"
      ;;
    migrate-loot)
      python3 "$INSTALL_DIR/bin/kitelon_db.py" migrate-loot --loot-root "$INSTALL_DIR/loot" || exit 1
      ;;
    migrate-artifacts)
      python3 "$INSTALL_DIR/bin/kitelon_db.py" migrate-artifacts --loot-root "$INSTALL_DIR/loot" "$@" || exit 1
      ;;
    test)
      python3 "$INSTALL_DIR/bin/kitelon_db.py" test || exit 1
      echo -e "$KL_C_OK[✓]$KL_RESET PostgreSQL connection OK"
      ;;
    prune-workspaces)
      python3 "$INSTALL_DIR/bin/kitelon_db.py" prune-workspaces --loot-root "$INSTALL_DIR/loot" || exit 1
      ;;
    fix-loot-layout)
      python3 "$INSTALL_DIR/bin/kitelon_db.py" fix-loot-layout --loot-root "$INSTALL_DIR/loot" || exit 1
      ;;
    import)
      if [[ -z "$WORKSPACE" ]]; then
        echo "Usage: kitelon db import <WORKSPACE_ALIAS>"
        exit 1
      fi
      kitelon_apply_workspace
      LOOT_DIR="${WORKSPACE_DIR:-$INSTALL_DIR/loot/workspace/$WORKSPACE}"
      if [[ ! -d "$LOOT_DIR" ]]; then
        echo -e "$KL_C_ERR[!]$KL_RESET Workspace loot directory not found: $LOOT_DIR"
        exit 1
      fi
      kl_section "Importing loot and rebuilding reports for $WORKSPACE..."
      python3 "$INSTALL_DIR/bin/kitelon_loot.py" --loot-dir "$LOOT_DIR" --workspace "$WORKSPACE" --action all \
        || exit 1
      echo -e "$KL_C_OK[✓]$KL_RESET Imported loot and regenerated reports for $WORKSPACE"
      ;;
    *)
      echo "Usage: kitelon db migrate | migrate-loot | migrate-artifacts | test | import <WORKSPACE> | prune-workspaces | fix-loot-layout"
      exit 1
      ;;
  esac
  exit 0
fi

if [[ -n "$WORKSPACES_SUBCMD" ]]; then
  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  kitelon_export_db_env
  python3 "$INSTALL_DIR/bin/kitelon_crud.py" workspaces "$WORKSPACES_SUBCMD" "$@" || exit 1
  exit 0
fi

