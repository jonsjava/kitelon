  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  kitelon_export_db_env
  REPLACE_FLAG=""
  [[ -n "$IMPORT_REPLACE" ]] && REPLACE_FLAG="--replace"
  ALIAS_FLAG=""
  [[ -n "$WORKSPACE" ]] && ALIAS_FLAG="--alias $WORKSPACE"
  python3 "$INSTALL_DIR/bin/kitelon_workspace_pack.py" import "$IMPORT_ZIP" $ALIAS_FLAG $REPLACE_FLAG --loot-root "$INSTALL_DIR/loot" || exit 1
  exit 0
fi

if [[ -n "$JOBS_SUBCMD" ]]; then
  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  kitelon_export_db_env
  if [[ "$JOBS_SUBCMD" == "enqueue" ]]; then
    if [[ -z "$TARGET" ]] || [[ -z "$WORKSPACE" ]]; then
      echo "Usage: kitelon jobs enqueue -t <TARGET> -w <WORKSPACE> [-m MODE]"
      exit 1
    fi
    MODE="${MODE:-normal}"
    python3 "$INSTALL_DIR/bin/kitelon_crud.py" jobs create \
      --type scan --workspace "$WORKSPACE" --target "$TARGET" --mode "$MODE" \
      --created-by cli || exit 1
    echo -e "$KL_C_OK[✓]$KL_RESET Enqueued scan job for $TARGET (workspace $WORKSPACE)"
    exit 0
  fi
  python3 "$INSTALL_DIR/bin/kitelon_crud.py" jobs "$JOBS_SUBCMD" "$@" || exit 1
  exit 0
fi

if [[ "$WEB_MODE" == "1" ]]; then
  export KITELON_INSTALL_DIR="$INSTALL_DIR"
  export KITELON_BIN="$_KITELON_BIN"
  export KITELON_WEB_ROOT="$INSTALL_DIR/web"
  export KITELON_LOOT_ROOT="$INSTALL_DIR/loot"
  export WEB_BIND="${WEB_BIND:-127.0.0.1}"
  export WEB_PORT="${WEB_PORT:-8080}"
  export WEB_API_KEY="${WEB_API_KEY:-}"
  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  echo -e "$KL_C_INFO[*]$KL_RESET Starting Kitelon Web UI at http://${WEB_BIND}:${WEB_PORT}"
  exec python3 "$INSTALL_DIR/bin/kitelon_api.py"
fi

if [[ ! -z "$TARGET" ]] && [[ -z "$WORKSPACE" ]]; then
  echo -e "$KL_C_ERR[!]$KL_RESET You need to set a workspace via the -w switch."
  exit 1
fi
kitelon_apply_workspace

if [[ -z "$TARGET" ]] && [[ -z "$WORKSPACE" ]]; then
  kl_print_header
  echo "You need to specify a target or workspace to use. Type kitelon --help for command usage."
  exit
fi

cd $INSTALL_DIR

function init {
  kitelon_apply_workspace
  WORKSPACE_ROOT="$INSTALL_DIR/loot/workspace"
  if [[ -n "$WORKSPACE_DIR" ]] && [[ "$WORKSPACE_DIR" != "$WORKSPACE_ROOT" ]]; then
    LOOT_DIR="$WORKSPACE_DIR"
  fi
  echo -e "$KL_C_INFO[*]$KL_RESET Saving loot to $LOOT_DIR $KL_C_INFO[$KL_RESET${KL_C_OK}OK${KL_RESET}$KL_C_INFO]$KL_RESET"
  kitelon_init_workspace_dirs "$LOOT_DIR"
  TARGET="$(echo $TARGET | sed 's/https:\/\///g' | sed 's/http:\/\///g')"
  rm -f /tmp/out_of_scope 2> /dev/null
  for key in "${OUT_OF_SCOPE[@]}"; do echo $TARGET | egrep ${key} >> /tmp/out_of_scope 2> /dev/null; done;
  OUT_OF_SCOPE_NUM=$(wc -l /tmp/out_of_scope 2> /dev/null | awk '{print $1}' 2> /dev/null)
  if [[ $OUT_OF_SCOPE_NUM > 0 ]]; then
    echo -e "$KL_C_INFO[$KL_RESET${KL_C_ERR}i${KL_RESET}$KL_C_INFO] $TARGET is out of scope. Skipping! $KL_RESET"
    exit
  else
    echo -e "$KL_C_INFO[*]$KL_RESET Scanning $TARGET $KL_C_INFO[$KL_RESET${KL_C_OK}OK${KL_RESET}$KL_C_INFO]$KL_RESET"
  fi
}

function loot {
  if [[ ! $LOOT == "0" ]]; then
    kitelon_banner
    echo ""
    if [[ -n "$WORKSPACE_DIR" ]]; then
      LOOT_DIR=$WORKSPACE_DIR
    fi
    kitelon_init_workspace_dirs "$LOOT_DIR" || {
      echo -e "$KL_C_ERR[!]$KL_RESET Loot directory unavailable: $LOOT_DIR"
      return 1
    }
    if [[ "$LOOT_DB" == "1" ]] || [[ "$LOOT_REPORT" == "1" ]]; then
      LOOT_ACTION="all"
      [[ "$LOOT_DB" == "1" && "$LOOT_REPORT" != "1" ]] && LOOT_ACTION="import"
      [[ "$LOOT_DB" != "1" && "$LOOT_REPORT" == "1" ]] && LOOT_ACTION="report"
      kl_section "Building workspace database and reports..."
      export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
      python3 "$INSTALL_DIR/bin/kitelon_loot.py" --loot-dir "$LOOT_DIR" --workspace "$WORKSPACE" --action "$LOOT_ACTION" \
        || echo -e "$KL_C_ERR[!]$KL_RESET Loot import/report failed."
    fi
    if [[ -f "$LOOT_DIR/kitelon-report.html" ]] && [[ "$REPORT" != "0" ]] && [[ "$NOLOOT" != "1" ]]; then
      kl_section "Opening workspace report..."
      $BROWSER "$LOOT_DIR/kitelon-report.html" 2> /dev/null > /dev/null &
    fi
    if [[ -f "$POST_LOOT_HOOK" ]]; then
      source "$POST_LOOT_HOOK"
    fi
    kl_section "Done."
  fi
}

function kitelon_run_scan {
  kl_require_authorized_use
  init
  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  SCAN_CMD=(python3 "$INSTALL_DIR/bin/kitelon_scan.py" --target "$TARGET" --mode "${MODE:-normal}")
  [[ -n "$WORKSPACE" ]] && SCAN_CMD+=(--workspace "$WORKSPACE")
  [[ "$RESUME" == "1" ]] && SCAN_CMD+=(--resume)
  [[ "$OSINT" == "1" ]] && SCAN_CMD+=(--osint)
  [[ "$RECON" == "1" ]] && SCAN_CMD+=(--recon)
  [[ -n "$PRESET" ]] && SCAN_CMD+=(--preset "$PRESET")
  [[ "$FULLNMAPSCAN" == "1" ]] && SCAN_CMD+=(--full-port)
  [[ "$TESTSSL" == "1" ]] && SCAN_CMD+=(--testssl)
  [[ -n "$PORT" ]] && SCAN_CMD+=(--port "$PORT")
  [[ -n "$FILE" ]] && SCAN_CMD+=(--target-file "$FILE")
  "${SCAN_CMD[@]}"
  SCAN_EXIT=$?
  if [[ $SCAN_EXIT -eq 0 ]] && [[ "$LOOT" != "0" ]] && [[ -n "$WORKSPACE" ]]; then
    loot
  fi
  exit $SCAN_EXIT
}

if [[ "$REIMPORT" = "1" ]]; then
  if [[ ! -z "$WORKSPACE_DIR" ]]; then
    LOOT="1"
    loot
    exit
  fi
fi

if [[ "$TESTSSL_ONLY" = "1" ]]; then
  kl_require_authorized_use
  if [[ -z "$TARGET" ]] || [[ -z "$WORKSPACE" ]]; then
    echo -e "$KL_C_ERR[!]$KL_RESET --testssl-only requires -t <TARGET> and -w <WORKSPACE>"
    exit 1
  fi
  kitelon_init_workspace_dirs "$WORKSPACE_DIR"
  export PYTHONPATH="$INSTALL_DIR/bin${PYTHONPATH:+:$PYTHONPATH}"
  kitelon_export_db_env
  TESTSSL_PORT="${PORT:-443}"
  TESTSSL_ARGS=(
    run
    --workspace "$WORKSPACE"
    --target "$TARGET"
    --port "$TESTSSL_PORT"
    --loot-dir "$WORKSPACE_DIR"
    --install-dir "$INSTALL_DIR"
  )
  [[ -n "$TESTSSL_FORCE" ]] && TESTSSL_ARGS+=(--force)
  [[ -n "$TESTSSL_REPORTS" ]] && TESTSSL_ARGS+=(--reports)
  python3 "$INSTALL_DIR/bin/kitelon_testssl.py" "${TESTSSL_ARGS[@]}" || exit 1
  echo -e "$KL_C_OK[✓]$KL_RESET testssl evidence saved to workspace $WORKSPACE"
  exit 0
fi

if [[ "$RELOAD" = "1" ]]; then
  if [[ ! -z "$WORKSPACE_DIR" ]]; then
    $BROWSER $WORKSPACE_DIR/kitelon-report.html 2> /dev/null > /dev/null &
    exit
  fi
fi

if [[ -n "$TARGET" ]]; then
  kitelon_run_scan
fi

exit 0
