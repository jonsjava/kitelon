kitelon_normalize_workspace_name() {
  local n
  n=$(printf '%s' "$1" | tr '/ ' '-' | sed -E 's/-+/-/g; s/^-+|-+$//g')
  if [[ -z "$n" || "$n" == *..* || "$n" == .* ]]; then
    echo "invalid workspace alias: $1" >&2
    return 1
  fi
  if [[ ! "$n" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$ ]]; then
    echo "invalid workspace alias: $1" >&2
    return 1
  fi
  printf '%s\n' "$n"
}

kitelon_apply_workspace() {
  [[ -n "$WORKSPACE" ]] || return 0
  WORKSPACE="$(kitelon_normalize_workspace_name "$WORKSPACE")" || exit 1
  WORKSPACE_DIR="$INSTALL_DIR/loot/workspace/$WORKSPACE"
}

kitelon_init_workspace_dirs() {
  local dir="$1"
  [[ -n "$dir" ]] || return 1
  kitelon_secure_loot_dir "$dir"
  mkdir -p "$dir"/{artifacts/nmap,artifacts/web,artifacts/ssl,artifacts/recon,artifacts/ports,artifacts/tools,artifacts/screenshots,reports}
  touch "$dir/findings.jsonl" "$dir/manifest.json" "$dir/scan.log" 2>/dev/null
  kitelon_secure_loot "$dir"
}

