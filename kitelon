function kitelon_status {
  watch -n 1 -c 'ps -ef | egrep "kitelon|python|dirsearch|nmap|curl|wget|nikto" && echo "NETWORK CONNECTIONS..." && netstat -an | egrep "TIME_WAIT|EST"'
}

# Match only the kitelon CLI binary (not Cursor, plugins paths, or generic greps).
kitelon_cmd_is_binary() {
  local args="$1"
  [[ "$args" == *"${INSTALL_DIR}/kitelon "* ]] && return 0
  [[ "$args" == *" ${INSTALL_DIR}/kitelon "* ]] && return 0
  [[ "$args" == *"bash ${INSTALL_DIR}/kitelon"* ]] && return 0
  [[ "$args" == "/usr/local/bin/kitelon "* ]] && return 0
  [[ "$args" == *" /usr/local/bin/kitelon "* ]] && return 0
  [[ "$args" == *"bash /usr/local/bin/kitelon"* ]] && return 0
  [[ "$args" == "/usr/bin/kitelon "* ]] && return 0
  [[ "$args" == *" /usr/bin/kitelon "* ]] && return 0
  [[ "$args" == *"bash /usr/bin/kitelon"* ]] && return 0
  return 1
}

# Meta/admin invocations: not an active scan workload.
kitelon_cmd_is_meta() {
  local args="$1"
  case "$args" in
    *"--is-running"*|*"--stop"*|*"--help"*|*" --help"*|*"--list"*|*"--status"*)
      return 0
      ;;
    *"--reload"*|*"--export"*|*"--update"*|*" --update"*)
      return 0
      ;;
    *" -h"|*" -u"|*" -d"|*" --delete"*|*" -dh"*|*" -dt"*)
      return 0
      ;;
    *"-c "*|*" --config "*)
      return 0
      ;;
  esac
  return 1
}

# Active scan or loot job (reimport counts: it processes workspace data).
kitelon_cmd_is_workload() {
  local args="$1"
  kitelon_cmd_is_meta "$args" && return 1
  case "$args" in
    *"--reimport"*)
      return 0
      ;;
    *" -t "*|*" -t"*|*" -f "*|*" -f"*|*" -m "*|*" -m"*|*" -fp"*|*" -b"*|*" -o"*|*" -re"*|*" --preset "*)
      return 0
      ;;
  esac
  return 1
}

kitelon_collect_scan_roots() {
  local self=$$ pid args
  while read -r pid args; do
    [[ -z "$pid" || "$pid" -eq "$self" ]] && continue
    kitelon_cmd_is_binary "$args" || continue
    kitelon_cmd_is_workload "$args" || continue
    if [[ -n "$WORKSPACE" ]] && [[ "$args" != *" -w ${WORKSPACE}"* ]] && [[ "$args" != *" -w ${WORKSPACE} "* ]]; then
      continue
    fi
    if [[ -n "$TARGET" ]] && [[ "$args" != *" -t ${TARGET}"* ]] && [[ "$args" != *" -t ${TARGET} "* ]]; then
      continue
    fi
    echo "$pid"
  done < <(ps -eo pid=,args= 2>/dev/null)
}

kitelon_descendant_pids() {
  local root="$1" child
  for child in $(pgrep -P "$root" 2>/dev/null); do
    echo "$child"
    kitelon_descendant_pids "$child"
  done
}

kitelon_all_scan_pids() {
  local pid
  for pid in $(kitelon_collect_scan_roots); do
    echo "$pid"
    kitelon_descendant_pids "$pid"
  done | sort -nu
}

kitelon_clear_running_markers() {
  local scans_dir marker
  find "$INSTALL_DIR/loot" -path '*/scans/running_*.txt' -type f -delete 2>/dev/null
  while IFS= read -r scans_dir; do
    echo 0 > "$scans_dir/tasks-running.txt" 2>/dev/null
  done < <(find "$INSTALL_DIR/loot" -path '*/scans' -type d 2>/dev/null)
}

kitelon_is_running_cmd() {
  local pids
  pids=$(kitelon_all_scan_pids)
  if [[ -n "$pids" ]]; then
    echo "true"
    return 0
  fi
  echo "false"
  return 1
}

kitelon_stop_cmd() {
  local pid pids stopped=0
  pids=$(kitelon_all_scan_pids)
  if [[ -z "$pids" ]]; then
    kitelon_clear_running_markers
    echo "false"
    return 1
  fi
  for pid in $pids; do
    kill -TERM "$pid" 2>/dev/null && stopped=1
  done
  sleep 2
  for pid in $pids; do
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null && stopped=1
    fi
  done
  kitelon_clear_running_markers
  if [[ "$stopped" -eq 1 ]]; then
    echo "true"
    return 0
  fi
  echo "false"
  return 1
}

function check_update {
  if [[ "$ENABLE_AUTO_UPDATES" == "1" ]] && [[ "$ONLINE" == "1" ]]; then
    echo -e "$KL_C_INFO[$KL_RESET${KL_C_ERR}i${KL_RESET}$KL_C_INFO] Updates are available via$KL_C_ERR \"kitelon -u\"$KL_RESET when a git remote is configured."
  fi
  touch /tmp/kitelon-update-check.txt 2> /dev/null
}

function update {
  kl_print_header
  echo -e "$KL_C_INFO[*]$KL_RESET Checking for updates...$KL_C_INFO[$KL_RESET${KL_C_OK}OK${KL_RESET}$KL_C_INFO]$KL_RESET"

  if [[ "$ONLINE" == "0" ]]; then
    echo "No internet connection. Cannot check for updates."
    exit 1
  fi

  if ! command -v git &>/dev/null; then
    echo "git is not installed. Cannot update from source."
    exit 1
  fi

  REPO_ROOT=$(cd "$INSTALL_DIR" && git rev-parse --show-toplevel 2>/dev/null)
  if [[ -z "$REPO_ROOT" ]]; then
    echo "No git repository found at $INSTALL_DIR."
    echo "Configure a remote and reinstall from source, or copy updates manually."
    exit 1
  fi

  REMOTE=$(cd "$REPO_ROOT" && git remote 2>/dev/null | head -1)
  if [[ -z "$REMOTE" ]]; then
    echo "No git remote configured for this installation."
    echo "Add a remote to your checkout, then run: kitelon -u"
    exit 1
  fi

  echo -e "$KL_C_INFO[$KL_RESET${KL_C_ERR}i${KL_RESET}$KL_C_INFO] Pull updates from $REMOTE and reinstall? (y or n)$KL_RESET"
  read ans
  if [[ "$ans" = "y" ]] || [[ "$ans" = "Y" ]]; then
    cd "$REPO_ROOT"
    git pull "$REMOTE" "$(git branch --show-current 2>/dev/null || echo master)"
    bash "$REPO_ROOT/install.sh" force
    exit
  fi
}

if [[ "$UPDATE" = "1" ]]; then
  update
  exit
fi

function check_online {
  if curl --connect-timeout 3 -s https://github.com >/dev/null 2>&1; then
    ONLINE="1"
    echo -e "$KL_C_INFO[*]$KL_RESET Checking for active internet connection $KL_C_INFO[$KL_RESET${KL_C_OK}OK${KL_RESET}$KL_C_INFO]$KL_RESET"
  else
    ONLINE="0"
    echo -e "$KL_C_INFO[*]$KL_RESET Checking for active internet connection $KL_C_INFO[$KL_RESET${KL_C_ERR}FAIL${KL_RESET}$KL_C_INFO]"
    echo -e "$KL_C_INFO[$KL_RESET${KL_C_ERR}i${KL_RESET}$KL_C_INFO]$KL_RESET kitelon is running in offline mode.$KL_RESET"
  fi
}

# COMMAND LINE SWITCHES
DB_SUBCMD=""
JOBS_SUBCMD=""
WORKSPACES_SUBCMD=""
WEB_MODE=""
POSITIONAL=()
while [[ $# -gt 0 ]]
do
key="$1"

case $key in
    -h|--help)
    kl_help
    shift
    ;;
    -c|--config)
    CONFIG="$2"
    echo -e "$KL_C_INFO[*]$KL_RESET Creating backup of existing config to /root/.kitelon.conf.bak...$KL_C_INFO[$KL_RESET${KL_C_OK}OK${KL_RESET}$KL_C_INFO]$KL_RESET"
